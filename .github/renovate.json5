{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  timezone: 'Europe/Zurich',
  schedule: [
    'before 6am',
  ],
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',
  prHourlyLimit: 0,
  prConcurrentLimit: 20,
  labels: [
    'dependencies',
  ],
  dependencyDashboard: {
    enabled: true,
  },
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: [
      'dependencies',
      'security',
    ],
    minimumReleaseAge: null,
    schedule: [
      'at any time',
    ],
  },
  postUpdateOptions: [
    'gomodTidy',
    'gomodUpdateImportPaths',
  ],
  packageRules: [
    {
      matchManagers: [
        'gomod',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'Go modules',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
        'digest',
      ],
      groupName: 'GitHub Actions',
    },
    {
      matchManagers: [
        'gomod',
      ],
      matchDepTypes: [
        'golang',
        'toolchain',
      ],
      enabled: false,
    },
  ],
}
